pipeline {
    agent { label 'docker-agent' }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Git branch to checkout from Azure'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['uat', 'staging', 'prod'],
            description: 'Target environment'
        )

        booleanParam(
            name: 'SKIP_BUILD',
            defaultValue: false,
            description: 'Skip build stage'
        )

        booleanParam(
            name: 'SKIP_PUSH',
            defaultValue: false,
            description: 'Skip push to registry'
        )
    }

    environment {
        APP_NAME        = 'vp-fms-interceptor'
        REMOTE_HOST     = '10.230.83.136'
        REGISTRY        = 'repouat.maybank.co.id:8082'
        GIT_CREDENTIALS = '23834c4a-3c8a-47cb-bd51-c4662f9d64dd'
        SSH_CREDENTIALS = 'ssh-root'

        GIT_URL         = 'https://maybankdigitalteam.visualstudio.com/VP%20Listener/_git/VP%20Listener'
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.BRANCH?.trim()) {
                        error "Parameter BRANCH is required"
                    }

                    if (params.SKIP_BUILD == true && params.SKIP_PUSH == false) {
                        error "Invalid option: SKIP_BUILD=true but SKIP_PUSH=false. Push requires image tar from build stage."
                    }

                    env.TARGET_BRANCH = params.BRANCH.trim()
                    env.TARGET_ENVIRONMENT = params.ENVIRONMENT
                    env.SKIP_BUILD_VALUE = params.SKIP_BUILD.toString()
                    env.SKIP_PUSH_VALUE = params.SKIP_PUSH.toString()
                }

                sh '''
                    set -euo pipefail

                    echo "APP_NAME           : ${APP_NAME}"
                    echo "TARGET_BRANCH      : ${TARGET_BRANCH}"
                    echo "TARGET_ENVIRONMENT : ${TARGET_ENVIRONMENT}"
                    echo "REGISTRY           : ${REGISTRY}"
                    echo "REMOTE_HOST        : ${REMOTE_HOST}"
                    echo "SKIP_BUILD         : ${SKIP_BUILD_VALUE}"
                    echo "SKIP_PUSH          : ${SKIP_PUSH_VALUE}"
                '''
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -euo pipefail

                    echo "Check tools on Jenkins agent..."
                    git --version
                    podman --version
                    scp -V 2>&1 | head -1 || true
                    ssh -V 2>&1
                '''
            }
        }

        stage('Checkout Azure') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${env.TARGET_BRANCH}"]],
                    userRemoteConfigs: [[
                        credentialsId: "${env.GIT_CREDENTIALS}",
                        url: "${env.GIT_URL}"
                    ]],
                    extensions: [
                        [$class: 'CloneOption',
                            shallow: true,
                            depth: 1,
                            noTags: false,
                            timeout: 30
                        ]
                    ]
                ])

                sh '''
                    set -euo pipefail

                    echo "Git checkout completed."
                    echo ""
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Git branch:"
                    git branch -a

                    echo ""
                    echo "Latest commit:"
                    git log -1 --oneline
                '''
            }
        }

        stage('Prepare Image Metadata') {
            steps {
                script {
                    env.SAFE_BRANCH = env.TARGET_BRANCH.replaceAll('/', '-')
                    env.GIT_SHORT_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.TAG = "${env.SAFE_BRANCH}-${env.BUILD_NUMBER}-${env.GIT_SHORT_SHA}"
                    env.LOCAL_IMAGE = "${env.APP_NAME}:${env.TAG}"
                    env.REMOTE_IMAGE = "${env.REGISTRY}/${env.APP_NAME}:${env.TAG}"
                    env.IMAGE_TAR = "${env.APP_NAME}_${env.TAG}.tar"
                }

                sh '''
                    set -euo pipefail

                    echo "SAFE_BRANCH   : ${SAFE_BRANCH}"
                    echo "GIT_SHORT_SHA : ${GIT_SHORT_SHA}"
                    echo "TAG           : ${TAG}"
                    echo "LOCAL_IMAGE   : ${LOCAL_IMAGE}"
                    echo "REMOTE_IMAGE  : ${REMOTE_IMAGE}"
                    echo "IMAGE_TAR     : ${IMAGE_TAR}"
                '''
            }
        }

        stage('Build Image Rust Interceptor') {
            when {
                expression { params.SKIP_BUILD != true }
            }

            steps {
                sh '''
                    set -euo pipefail

                    echo "Check Dockerfile..."
                    test -f rust-interceptor/Dockerfile

                    echo ""
                    echo "Build image:"
                    echo "${LOCAL_IMAGE}"

                    podman build \
                      -f rust-interceptor/Dockerfile \
                      -t "${LOCAL_IMAGE}" \
                      .

                    echo ""
                    echo "Save image to tar:"
                    podman save "${LOCAL_IMAGE}" -o "${IMAGE_TAR}"

                    echo ""
                    echo "Validate image tar:"
                    ls -lh "${IMAGE_TAR}"
                '''
            }
        }

        stage('Validate Remote Host') {
            when {
                expression { params.SKIP_PUSH != true }
            }

            steps {
                sshagent(credentials: ["${env.SSH_CREDENTIALS}"]) {
                    sh '''
                        set -euo pipefail

                        echo "Check SSH connection to remote host..."
                        ssh -o StrictHostKeyChecking=no root@${REMOTE_HOST} "hostname && whoami && podman --version"

                        echo ""
                        echo "Check registry connectivity from remote host..."
                        ssh -o StrictHostKeyChecking=no root@${REMOTE_HOST} "curl -v --connect-timeout 10 http://${REGISTRY}/v2/ || true"
                    '''
                }
            }
        }

        stage('Push Image via Remote Host') {
            when {
                expression { params.SKIP_PUSH != true }
            }

            steps {
                sshagent(credentials: ["${env.SSH_CREDENTIALS}"]) {
                    sh '''
                        set -euo pipefail

                        echo "Check local image tar:"
                        ls -lh "${IMAGE_TAR}"

                        echo ""
                        echo "Copy image tar to remote host..."
                        scp -o StrictHostKeyChecking=no \
                          "${IMAGE_TAR}" \
                          root@${REMOTE_HOST}:/tmp/

                        echo ""
                        echo "Load image on remote host..."
                        ssh -o StrictHostKeyChecking=no root@${REMOTE_HOST} \
                          "podman load -i /tmp/${IMAGE_TAR}"

                        echo ""
                        echo "Tag image for registry..."
                        ssh -o StrictHostKeyChecking=no root@${REMOTE_HOST} \
                          "podman image tag ${LOCAL_IMAGE} ${REMOTE_IMAGE}"

                        echo ""
                        echo "Push image to registry..."
                        ssh -o StrictHostKeyChecking=no root@${REMOTE_HOST} \
                          "podman push ${REMOTE_IMAGE}"

                        echo ""
                        echo "Clean remote image tar..."
                        ssh -o StrictHostKeyChecking=no root@${REMOTE_HOST} \
                          "rm -f /tmp/${IMAGE_TAR}"

                        echo ""
                        echo "Image pushed successfully:"
                        echo "${REMOTE_IMAGE}"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                set +e

                echo "Cleanup local image tar..."
                rm -f vp-fms-interceptor_*.tar || true

                echo ""
                echo "Current podman images:"
                podman images | grep vp-fms-interceptor || true
            '''

            cleanWs()
        }

        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline failed."
        }
    }
}